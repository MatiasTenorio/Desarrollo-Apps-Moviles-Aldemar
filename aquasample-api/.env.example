# Copia este archivo como .env y completa los valores. .env NO se sube a git.
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Correo que queda como ADMINISTRADOR al arrancar el backend.
ADMIN_CORREO=
# Insforge (panel del proyecto). La API key de administrador nunca va en la app.
INSFORGE_URL=
INSFORGE_API_KEY=
